<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vmNoAuth="clr-namespace:MobileLink_Desktop.ViewModels.NoAuth"
             x:Class="MobileLink_Desktop.Views.NoAuth.Register"
             x:DataType="vmNoAuth:RegisterViewModel"
             >
	<Grid Background="White">
		<StackPanel
			VerticalAlignment="Center"
			HorizontalAlignment="Center">
			<TextBlock Text="Crie sua conta" FontSize="36" FontWeight="Bold" Foreground="#9465CF" Margin="0 20 0 0"/>
			<TextBlock Text="Email" FontSize="16" Foreground="#9465CF" Margin="0 10 0 0"/>
			<TextBox Text="{Binding Email}" Margin="0 10 0 0"/>
			<Button Command="{Binding SubmitValidateEmail}" Content="Validar email" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Background="#9465CF" Foreground="White"
                Width="150" Height="40" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0 20 0 0"/>
		</StackPanel>
	</Grid>
</UserControl>

