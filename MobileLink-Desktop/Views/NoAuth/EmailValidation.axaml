<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vmNoAuth="clr-namespace:MobileLink_Desktop.ViewModels.NoAuth"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="MobileLink_Desktop.Views.NoAuth.EmailValidation"
             x:DataType="vmNoAuth:EmailValidationViewModel">
    <!-- Background="White" -->
    <StackPanel
        VerticalAlignment="Stretch"
        HorizontalAlignment="Stretch">
        <Button Command="{Binding GoBack}" Content="Voltar"/>
        <StackPanel Margin="20">
            <TextBlock Text="Código de Verificação" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center"/>
            <TextBlock Text="Verifique seu email para colocar o código de verificação correto" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center"/>

            <Panel Margin="0,20">
                <TextBlock x:Name="ValidationResult" HorizontalAlignment="Center" Margin="0,10" />
                <Grid ColumnDefinitions="Auto, Auto, Auto, Auto, Auto, Auto">
                    <TextBox Text="{Binding Code[0]}"  MaxLength="1" Grid.Column="0" />
                    <TextBox Text="{Binding Code[1]}"  MaxLength="1" Grid.Column="1" />
                    <TextBox Text="{Binding Code[2]}"  MaxLength="1" Grid.Column="2" />
                    <TextBox Text="{Binding Code[3]}"  MaxLength="1" Grid.Column="3" />
                    <TextBox Text="{Binding Code[4]}"  MaxLength="1" Grid.Column="4" />
                    <TextBox Text="{Binding Code[5]}"  MaxLength="1" Grid.Column="5" />
                </Grid>
            </Panel>

            <Button Content="Validar" Command="{Binding SubmitVerificationCode}"/>

        </StackPanel>
    </StackPanel>
</UserControl>
