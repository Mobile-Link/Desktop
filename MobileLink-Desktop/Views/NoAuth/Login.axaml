<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             xmlns:vmNoAuth="clr-namespace:MobileLink_Desktop.ViewModels.NoAuth"
             x:Class="MobileLink_Desktop.Views.NoAuth.Login"
             x:DataType="vmNoAuth:LoginViewModel"
             >
	
	<Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*"/>
      <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>

    <!-- Coluna Esquerda -->
    <Grid Grid.Column="0" Background="#8A2BE2">
      <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
        <TextBlock Text="Bem-Vindo" FontSize="32" FontWeight="Bold" Foreground="White"/>
        <TextBlock Text="de Volta" FontSize="24" Foreground="White" Margin="0,10,0,0"/>
      </StackPanel>
      <StackPanel VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,20">
        <TextBlock Text="Ainda não tem conta?" FontSize="16" Foreground="White" Margin="0,0,0,10"/>
        <Button Content="Criar conta" Background="White" Foreground="#8A2BE2" 
                Width="150" Height="40" FontSize="16"/>
      </StackPanel>
    </Grid>

    <!-- Coluna Direita -->
    <Grid Grid.Column="1" Margin="20">
      <StackPanel VerticalAlignment="Center">
        <TextBlock Text="Faça seu Login" FontSize="24" FontWeight="Bold" Margin="0,0,0,20"/>
        <TextBox Watermark="Email" Margin="0,0,0,10"/>
        <TextBox Watermark="Senha" PasswordChar="*" Margin="0,0,0,20"/>
        <Button Content="Login" Background="#8A2BE2" Foreground="White" 
                Width="150" Height="40" HorizontalAlignment="Left"/>
        <Button Text="Esqueceu sua senha?" Foreground="#8A2BE2" 
                   Margin="0,10,0,0" Cursor="Hand"/>
      </StackPanel>
    </Grid>
  </Grid>
	
</UserControl>
