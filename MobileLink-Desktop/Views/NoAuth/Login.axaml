<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             xmlns:vmNoAuth="clr-namespace:MobileLink_Desktop.ViewModels.NoAuth"
             x:Class="MobileLink_Desktop.Views.NoAuth.Login"
             x:DataType="vmNoAuth:LoginViewModel"
             >
	
    <Grid Grid.Column="1" Background="White">
      <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
        <TextBlock Text="Faça seu Login" FontSize="36" FontWeight="Bold" Foreground="#9465CF" Margin="0,0,0,20"/>
        <TextBox Watermark="Email" Text="{Binding EmailUser}" Margin="0,0,0,10"/>
        <TextBox Watermark="Senha" Text="{Binding Password}" PasswordChar="*" Margin="0,0,0,20"/>
        <Button Command="{Binding SubmitLogin}" Content="Login" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Background="#9465CF" Foreground="White" 
                Width="150" Height="40" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        <!--
		  <Button Content="Esqueceu sua senha?" Foreground="#8A2BE2" 
                   Margin="0,10,0,0" Cursor="Hand"/>
		-->
      </StackPanel>
    </Grid>
	
</UserControl>
